@page "/"
@using TocBuilder.Domain
@using TocBuilder.Web.Client.Components
@inject TreeLibrary Library
@inject IJSRuntime Js
@inject ISuggestionProvider Provider

<PageTitle>TOC Builder</PageTitle>

<div class="editor">
    <LibraryBar Trees="trees" CurrentId="@currentId" TreeName="@treeName" EditRevision="editRevision"
                @bind-ConfirmingDelete="confirmingDelete" HasEntities="@(tree.Entities.Count > 0)"
                OnOpen="OpenTree" OnRename="RenameTree" OnNew="NewTree" OnDelete="DeleteTree" OnExportJson="ExportTree"
                OnExportImage="ExportImage" OnImport="ImportTree" />

    <ScopeBar @ref="scopeBar" Scope="@tree.Scope" EditRevision="editRevision" OnEdit="EditScope" />

    <AddEntityForm @bind-Statement="statement" OnSubmit="AddEntity" />

    <Toolbar CanUndo="tree.CanUndo" CanRedo="tree.CanRedo" HasSelection="@(selected is not null)" HasJunction="@(selectedJunction is not null)"
             SelectedEntity="SelectedEntity" Linking="linking" JunctionMode="junctionMode" GroupMemberCount="groupMembers.Count"
             Suggesting="suggesting" SelectedGhost="selectedGhost" @bind-GhostEdit="ghostEdit"
             ZoomPercent="@((int)Math.Round(viewport.Scale * 100))" CanRerunLayout="@(nudges.Count > 0)"
             Message="@message" MessageIsError="messageIsError" EditRevision="editRevision"
             OnUndo="Undo" OnRedo="Redo" OnAddCause="AddCause" OnAddEffect="AddEffect" OnToggleLinking="ToggleLinking"
             OnStartGrouping="StartGrouping" OnApplyGrouping="ApplyGrouping" OnDelete="DeleteSelected"
             OnStartJunctionMode="StartJunctionMode" OnUngroup="Ungroup" OnEditSelected="EditSelected" OnTagSelected="TagSelected"
             OnSuggest="Suggest" OnAcceptGhost="AcceptGhost" OnDismissGhost="DismissGhost"
             OnZoom="ZoomBy" OnFit="Fit" OnRerunLayout="RerunLayout" />

    <div class="workspace">
    <EditorCanvas @ref="canvas" Tree="tree" Placement="placement" Viewport="viewport" Selected="selected" SelectedJunction="selectedJunction"
                  SelectedLink="selectedLink" GroupMembers="groupMembers" Suggestions="suggestions" GhostAnchor="ghostAnchor"
                  SelectedGhost="selectedGhost" ConsumeSuppressedClick="ConsumeSuppressedClick"
                  OnKeyDown="OnKeyDown" OnWheel="OnWheel" OnPointerMove="OnPointerMove" OnPointerUp="EndDrag" OnPointerLeave="CancelDrag"
                  OnStartPan="StartPan" OnStartEntityDrag="@(drag => StartEntityDrag(drag.Id, drag.Args))" OnDeselect="Deselect" OnSelectEntity="Select"
                  OnSelectLink="SelectLink" OnSelectJunction="SelectJunction" OnSelectGhost="SelectGhost" />

    <aside class="report" aria-label="Tree report">
        <h2>Tree report</h2>
        <TreeReport Tree="tree" Report="report" OnSelectEntity="Select" OnSelectTarget="SelectTarget" />
        <ReservationPanel Tree="tree" Target="CurrentTarget" EditRevision="editRevision"
                          OnRaise="@(raised => Raise(raised.Target, raised.Category))"
                          OnChangeState="@(change => ChangeReservationState(change.Id, change.Args))" OnChangeNote="@(change => ChangeReservationNote(change.Id, change.Args))" />
    </aside>
    </div>
</div>

@code {
    private Tree tree = new();
    private TreeLayout.Result baseLayout = TreeLayout.Compute(new Tree());   // automatic layout, before any dragging
    private TreeLayout.Result placement = TreeLayout.Compute(new Tree());   // what is drawn: the layout plus the nudges
    private readonly Dictionary<EntityId, Nudge> nudges = [];   // how far each dragged entity sits from its laid-out position; saved with the tree
    private Viewport viewport = Viewport.Identity;
    private enum Drag { None, Pan, Entity }
    private Drag drag;
    private EntityId draggedEntity;
    private double lastX, lastY;   // where the pointer was when the drag last moved something
    private bool dragMoved;
    private bool suppressClick;   // the click that ends a drag must not select or deselect anything
    private SuggestionSet? suggestions;   // the Suggestions on screen as ghost Entities; never part of the tree
    private EntityId ghostAnchor;   // the Entity the ghosts hang off
    private Suggestion? selectedGhost;
    private string ghostEdit = "";
    private bool suggesting;
    private bool scopePrompted;   // the user is asked for a Scope the first time they request Suggestions without one
    private ScopeBar scopeBar = null!;
    private EntityId? selected;
    private bool linking;
    private JunctionMode junctionMode;
    private readonly HashSet<EntityId> groupMembers = [];
    private JunctionId? selectedJunction;
    private CausalLink? selectedLink;
    private string statement = "";
    private string message = "";
    private bool messageIsError;
    private int editRevision;   // changing it replaces the edit box, so it shows the kept statement again
    private EditorCanvas canvas = null!;
    private bool focusCanvas;

    private const double WheelSensitivity = 0.0015, DragThreshold = 3;

    private TocBuilder.Domain.TreeReport report = new Tree().Report();

    private List<SavedTree> trees = [];
    private string currentId = "";
    private string treeName = "";
    private bool confirmingDelete;
    private bool unsaved;   // set by Refresh after a change, saved once the page has rendered

    protected override async Task OnInitializedAsync()
    {
        trees = await Library.ListAsync();
        var preferred = await Library.CurrentIdAsync();
        var candidates = trees.OrderBy(t => t.Id == preferred ? 0 : 1).ToList();
        foreach (var candidate in candidates)
        {
            if (await TryOpen(candidate)) return;
        }
        await CreateTree("Untitled tree");
    }

    private async Task<bool> TryOpen(SavedTree saved)
    {
        var result = await Library.LoadAsync(saved.Id);
        if (result.Tree is null)
        {
            Report($"Could not open \"{saved.Name}\": {result.Message}", isError: true);
            return false;
        }
        Show(saved.Id, saved.Name, result.Tree, result.Nudges);
        await Library.SetCurrentAsync(saved.Id);
        return true;
    }

    // Swaps the open tree. The new tree is already stored, so nothing is saved.
    private void Show(string id, string name, Tree opened, IReadOnlyDictionary<EntityId, Nudge>? openedNudges = null)
    {
        tree = opened;
        currentId = id;
        treeName = name;
        confirmingDelete = false;
        nudges.Clear();
        foreach (var (entity, nudge) in openedNudges ?? new Dictionary<EntityId, Nudge>()) nudges[entity] = nudge;
        viewport = Viewport.Identity;
        ClearSuggestions();
        CancelDrag();
        ClearSelection();
        ClearModes();
        statement = "";
        editRevision++;
        Refresh();
        unsaved = false;
    }

    private async Task CreateTree(string name, Tree? content = null, IReadOnlyDictionary<EntityId, Nudge>? contentNudges = null)
    {
        var id = Guid.NewGuid().ToString("N");
        var created = content ?? new Tree();
        await Library.SaveAsync(id, name, created, contentNudges);
        trees = await Library.ListAsync();
        Show(id, name, created, contentNudges);
        await Library.SetCurrentAsync(id);
    }

    private async Task NewTree()
    {
        await SaveIfNeeded();
        Begin();
        await CreateTree("Untitled tree");
    }

    private async Task OpenTree(ChangeEventArgs e)
    {
        await SaveIfNeeded();
        Begin();
        var saved = trees.FirstOrDefault(t => t.Id == e.Value?.ToString());
        if (saved is not null) await TryOpen(saved);
        editRevision++;   // if opening failed, the list must show the tree that is still open
    }

    private async Task RenameTree(ChangeEventArgs e)
    {
        Begin();
        var name = e.Value?.ToString()?.Trim() ?? "";
        if (name == "")
        {
            Report("A tree needs a name.", isError: true);
            editRevision++;
            return;
        }
        treeName = name;
        await Library.SaveAsync(currentId, treeName, tree, nudges);
        trees = await Library.ListAsync();
    }

    private async Task DeleteTree()
    {
        Begin();
        await Library.DeleteAsync(currentId);
        trees = await Library.ListAsync();
        foreach (var remaining in trees)
        {
            if (await TryOpen(remaining)) return;
        }
        await CreateTree("Untitled tree");
    }

    private async Task ExportTree()
    {
        Begin();
        await Library.DownloadAsync(FileName(".toc.json"), TreeSerializer.Export(treeName, tree, nudges));
    }

    private string FileName(string extension) =>
        string.Concat(treeName.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c)) + extension;

    // The picture shows the whole tree whatever the pan and zoom.
    private async Task ExportImage(bool png)
    {
        Begin();
        if (tree.Entities.Count == 0) return;
        var svg = TreeSvg.Render(tree, placement);
        try
        {
            if (png) await Js.InvokeVoidAsync("tocBuilder.downloadPng", FileName(".png"), svg);
            else await Js.InvokeVoidAsync("tocBuilder.download", FileName(".svg"), svg, "image/svg+xml");
        }
        catch (JSException ex)
        {
            Report($"Could not export the image: {ex.Message}", isError: true);
        }
    }

    // A refused file never touches the open tree: nothing changes until the import has succeeded.
    private async Task ImportTree(InputFileChangeEventArgs e)
    {
        Begin();
        string json;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
            json = await reader.ReadToEndAsync();
        }
        catch (IOException ex)
        {
            Report($"Could not read the file: {ex.Message}", isError: true);
            return;
        }
        var result = TreeSerializer.Import(json);
        if (result.Tree is null)
        {
            Report(result.Message ?? "The file could not be imported.", isError: true);
            return;
        }
        await SaveIfNeeded();
        await CreateTree(result.Name ?? "Imported tree", result.Tree, result.Nudges);
        Report($"Imported \"{treeName}\".");
    }

    private async Task SaveIfNeeded()
    {
        if (!unsaved) return;
        unsaved = false;
        try
        {
            await Library.SaveAsync(currentId, treeName, tree, nudges);
        }
        catch (JSException ex)   // e.g. storage full or disabled; the next change tries again (leaving the flag set would retry on every render)
        {
            Report($"Could not save to this browser: {ex.Message} Export the tree to keep it.", isError: true);
            StateHasChanged();
        }
    }

    private Entity? SelectedEntity => selected is { } id ? tree.Entities.First(e => e.Id == id) : null;

    private ReservationTarget? CurrentTarget =>
        selectedJunction is { } junction ? new OnJunction(junction)
        : selectedLink is { } link ? new OnLink(link)
        : selected is { } entity ? new OnEntity(entity)
        : null;

    // The text typed in the "add entity" box names the next entity added, otherwise the default is used.
    private string TakeStatement(string fallback)
    {
        var text = string.IsNullOrWhiteSpace(statement) ? fallback : statement;
        statement = "";
        return text;
    }

    private void AddEntity()
    {
        if (string.IsNullOrWhiteSpace(statement)) return;
        Begin();
        SelectNew(tree.AddEntity(TakeStatement("")));
    }

    private void AddCause()
    {
        if (selected is not { } effect) return;
        Begin();
        SelectNew(tree.AddCause(effect, TakeStatement("New cause")));
    }

    private void AddEffect()
    {
        if (selected is not { } cause) return;
        Begin();
        SelectNew(tree.AddEffect(cause, TakeStatement("New effect")));
    }

    private void DeleteSelected()
    {
        if (selected is null) { Ungroup(); return; }
        var id = selected.Value;
        Begin();
        tree.Delete(id);
        ClearSuggestions();
        selected = null;
        ClearModes();
        Refresh();
        focusCanvas = true;
    }

    private void EditSelected(ChangeEventArgs e)
    {
        if (selected is not { } id) return;
        Begin();
        var text = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(text))
        {
            Report("A statement cannot be blank; the previous one was kept.", isError: true);
            editRevision++;
            return;
        }
        tree.EditStatement(id, text);
        Refresh();
    }

    private void TagSelected(ChangeEventArgs e)
    {
        if (selected is not { } id || !Enum.TryParse<EntityTag>(e.Value?.ToString(), out var tag)) return;
        Begin();
        tree.SetTag(id, tag);
        Refresh();
    }

    private void Raise(ReservationTarget target, ClrCategory category)
    {
        Begin();
        tree.RaiseReservation(target, category);
        Refresh();
    }

    private void ChangeReservationState(ReservationId id, ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReservationState>(e.Value?.ToString(), out var state)) return;
        Begin();
        tree.SetReservationState(id, state);
        Refresh();
    }

    private void ChangeReservationNote(ReservationId id, ChangeEventArgs e)
    {
        Begin();
        tree.SetReservationNote(id, e.Value?.ToString() ?? "");
        Refresh();
    }

    private void EditScope(ChangeEventArgs e)
    {
        Begin();
        tree.SetScope(e.Value?.ToString() ?? "");
        Refresh();
        editRevision++;   // show the trimmed scope
    }

    // Suggestions are only ever requested here, by the user pressing a button.
    private async Task Suggest(SuggestionKind kind)
    {
        Begin();
        EntityId anchor;
        if (kind == SuggestionKind.CoCause)
        {
            if (selectedJunction is not { } junctionId) return;
            anchor = tree.Junctions.First(j => j.Id == junctionId).Effect;
        }
        else if (selected is { } entity) anchor = entity;
        else return;
        if (tree.Scope.Length == 0 && !scopePrompted)
        {
            scopePrompted = true;
            Report("Suggestions work best with a Scope. Write one, then ask again, or ask again to continue without.");
            await scopeBar.FocusAsync();
            return;
        }
        var asked = tree;
        var askedJunction = selectedJunction;
        var request = new SuggestionApiRequest(TreeSerializer.Export("tree", tree), kind, kind == SuggestionKind.CoCause ? null : anchor, kind == SuggestionKind.CoCause ? askedJunction : null);
        suggesting = true;
        IReadOnlyList<Suggestion> candidates;
        try { candidates = await Provider.SuggestAsync(request); }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Report($"Could not get suggestions: {ex.Message}", isError: true);
            return;
        }
        finally { suggesting = false; }
        if (!ReferenceEquals(asked, tree) || tree.Entities.All(e => e.Id != anchor)) return;   // another tree was opened, or the Entity deleted, while waiting
        var set = kind == SuggestionKind.CoCause && askedJunction is { } junction
            ? SuggestionSet.ForJunction(tree, junction, candidates)
            : SuggestionSet.ForEntity(tree, anchor, candidates);
        ClearSuggestions();
        if (set.Pending.Count == 0) { Report("No valid suggestions."); return; }
        suggestions = set;
        ghostAnchor = anchor;
    }

    private void ClearSuggestions()
    {
        suggestions = null;
        selectedGhost = null;
    }

    private void SelectGhost(Suggestion ghost)
    {
        if (ConsumeSuppressedClick()) return;
        Begin();
        ClearModes();
        ClearSelection();
        selectedGhost = ghost;
        ghostEdit = ghost.Statement;
        focusCanvas = true;
    }

    private void AcceptGhost()
    {
        if (suggestions is null || selectedGhost is not { } ghost) return;
        Begin();
        var edited = ghost.Existing is null && ghostEdit.Trim() != ghost.Statement ? ghostEdit : null;
        AcceptOutcome outcome;
        try { outcome = suggestions.Accept(tree, ghost, edited); }
        catch (ArgumentException)
        {
            Report("A statement cannot be blank.", isError: true);
            return;
        }
        switch (outcome)
        {
            case AcceptOutcome.Accepted: Report("Added the suggestion."); break;
            case AcceptOutcome.DuplicateStatement: Report("An entity with that statement already exists.", isError: true); return;
            case AcceptOutcome.NoLongerValid: Report("That suggestion no longer applies.", isError: true); break;
        }
        selectedGhost = null;
        if (suggestions.Pending.Count == 0) suggestions = null;
        Refresh();
        focusCanvas = true;
    }

    private void DismissGhost()
    {
        if (suggestions is null || selectedGhost is not { } ghost) return;
        Begin();
        suggestions.Dismiss(ghost);
        selectedGhost = null;
        if (suggestions.Pending.Count == 0) suggestions = null;
        focusCanvas = true;
    }

    private void SelectLink(CausalLink link)
    {
        Begin();
        ClearModes();
        ClearSelection();
        selectedLink = link;
        focusCanvas = true;
    }

    private void SelectTarget(ReservationTarget target)
    {
        Begin();
        ClearModes();
        ClearSelection();
        switch (target)
        {
            case OnEntity entity: selected = entity.Entity; break;
            case OnLink link: selectedLink = link.Link; break;
            case OnJunction junction: selectedJunction = junction.Junction; break;
        }
        focusCanvas = true;
    }

    private void Undo() => Travel(tree.Undo());
    private void Redo() => Travel(tree.Redo());

    private void Travel(bool changed)
    {
        Begin();
        if (!changed) return;
        if (selected is { } id && tree.Entities.All(e => e.Id != id)) selected = null;   // the selected entity may not exist in the restored tree
        ClearModes();
        if (selectedJunction is { } junction && tree.Junctions.All(j => j.Id != junction)) selectedJunction = null;
        if (selectedLink is { } link && !tree.Links.Contains(link)) selectedLink = null;
        ClearSuggestions();   // the Entity they hang off may have gone
        editRevision++;   // the kept statement may differ after the restore, so rebuild the edit box
        Refresh();
        focusCanvas = true;
    }

    private void ToggleLinking()
    {
        Begin();
        var wasLinking = linking;
        ClearModes();
        linking = !wasLinking;
        if (linking) Report("Click the entity it is a cause of, or press Escape to cancel.");
        focusCanvas = true;
    }

    private void Select(EntityId id)
    {
        if (linking && selected is not null) { LinkSelectedTo(id); return; }   // linking an entity to itself is reported as a cycle
        if (junctionMode == JunctionMode.Grouping && selected is { } effect)
        {
            if (id != effect && !groupMembers.Remove(id)) groupMembers.Add(id);
            return;
        }
        if (selectedJunction is { } junction && junctionMode != JunctionMode.None) { ChangeJunction(junction, id); return; }
        ClearModes();
        ClearSelection();
        selected = id;
    }

    private void SelectJunction(JunctionId id)
    {
        Begin();
        ClearModes();
        ClearSelection();
        selectedJunction = id;
        focusCanvas = true;
    }

    private void StartGrouping()
    {
        if (selected is null) return;
        Begin();
        var wasGrouping = junctionMode == JunctionMode.Grouping;
        ClearModes();
        if (wasGrouping) return;
        junctionMode = JunctionMode.Grouping;
        Report("Click two or more causes of the selected entity, then apply. Escape cancels.");
        focusCanvas = true;
    }

    private void ApplyGrouping()
    {
        if (selected is not { } effect) return;
        Begin();
        var result = tree.Group(effect, [.. groupMembers]);
        if (result.Outcome != JunctionOutcome.Done) { Report(Explain(result.Outcome), isError: true); return; }
        ClearModes();
        selected = null;
        selectedJunction = result.Junction!.Id;
        Report("Grouped.");
        Refresh();
        focusCanvas = true;
    }

    private void StartJunctionMode(JunctionMode mode)
    {
        Begin();
        var wasMode = junctionMode;
        ClearModes();
        if (wasMode == mode) return;
        junctionMode = mode;
        Report(mode == JunctionMode.Adding ? "Click the entity to add as a cause to this AND-junction." : "Click the cause to take out of this AND-junction.");
        focusCanvas = true;
    }

    private void ChangeJunction(JunctionId junction, EntityId entity)
    {
        Begin();
        if (junctionMode == JunctionMode.Removing)
        {
            if (!tree.Junctions.First(j => j.Id == junction).Causes.Contains(entity)) { Report("That entity is not in this AND-junction.", isError: true); return; }
            tree.RemoveFromJunction(junction, entity);
            if (tree.Junctions.All(j => j.Id != junction)) selectedJunction = null;   // left with one cause, so it dissolved
            Report("Removed from the AND-junction.");
        }
        else
        {
            var outcome = tree.AddToJunction(junction, entity);
            if (outcome != JunctionOutcome.Done) { Report(Explain(outcome), isError: true); return; }
            Report("Added to the AND-junction.");
        }
        ClearModes();
        Refresh();
    }

    private void Ungroup()
    {
        if (selectedJunction is not { } id) return;
        Begin();
        tree.Ungroup(id);
        selectedJunction = null;
        ClearModes();
        Refresh();
        focusCanvas = true;
    }

    private static string Explain(JunctionOutcome outcome) => outcome switch
    {
        JunctionOutcome.TooFewCauses => "An AND-junction needs at least two causes.",
        JunctionOutcome.NotACauseOfEffect => "Every grouped entity must already be a cause of the selected entity.",
        JunctionOutcome.AlreadyInJunction => "That cause is already in an AND-junction for this effect.",
        JunctionOutcome.WouldCreateCycle => "Rejected: that would create a cycle.",
        _ => throw new InvalidOperationException($"Unhandled junction outcome {outcome}.")
    };

    private void ClearModes()
    {
        linking = false;
        junctionMode = JunctionMode.None;
        groupMembers.Clear();
    }

    private void LinkSelectedTo(EntityId effect)
    {
        Begin();
        var outcome = tree.Link(selected!.Value, effect);
        switch (outcome)
        {
            case LinkOutcome.Linked: Report("Linked."); break;
            case LinkOutcome.AlreadyLinked: Report("Those entities are already linked."); break;
            case LinkOutcome.WouldCreateCycle: Report("Rejected: that link would create a cycle.", isError: true); break;
            default: throw new InvalidOperationException($"Unhandled link outcome {outcome}.");
        }
        Refresh();
        ClearModes();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            switch (e.Key.ToLowerInvariant())
            {
                case "z" when e.ShiftKey: Redo(); break;
                case "z": Undo(); break;
                case "y": Redo(); break;
                default: return;
            }
            return;
        }
        switch (e.Key)
        {
            case "Tab": AddCause(); break;
            case "Delete": DeleteSelected(); break;
            case "Escape" when linking || junctionMode != JunctionMode.None: ClearModes(); Report(""); break;
            case "Escape": ClearSelection(); break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SaveIfNeeded();
        if (!focusCanvas) return;
        focusCanvas = false;
        await canvas.Element.FocusAsync();
    }

    private void Begin() => Report("");

    private void Report(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }

    private void SelectNew(Entity entity)
    {
        ClearSelection();
        selected = entity.Id;
        ClearModes();
        Refresh();
        focusCanvas = true;   // so the keyboard can keep building straight away
    }

    private void Deselect()
    {
        if (ConsumeSuppressedClick()) return;
        ClearSelection();
        ClearModes();
    }

    private bool ConsumeSuppressedClick()
    {
        var suppressed = suppressClick;
        suppressClick = false;
        return suppressed;
    }

    private async Task<(double Left, double Top, double Width, double Height)> CanvasRect()
    {
        var rect = await Js.InvokeAsync<double[]>("tocBuilder.rect", canvas.Element);
        return (rect[0], rect[1], rect[2], rect[3]);
    }

    private async Task OnWheel(WheelEventArgs e)
    {
        var rect = await CanvasRect();
        var lines = e.DeltaMode == 1 ? 16 : 1;   // Firefox can report lines rather than pixels
        viewport = viewport.ZoomAt(Math.Exp(-e.DeltaY * lines * WheelSensitivity), e.ClientX - rect.Left, e.ClientY - rect.Top);
    }

    private async Task ZoomBy(double factor)
    {
        var rect = await CanvasRect();
        viewport = viewport.ZoomAt(factor, rect.Width / 2, rect.Height / 2);
    }

    private async Task Fit()
    {
        if (tree.Entities.Count == 0) return;
        var rect = await CanvasRect();
        var xs = placement.Positions.Values.Select(p => p.X).ToList();
        var ys = placement.Positions.Values.Select(p => p.Y).ToList();
        var left = xs.Min() - TreeLayout.Margin;
        var top = ys.Min() - TreeSvg.LabelHeight - TreeLayout.Margin;
        viewport = Viewport.Fit(left, top, xs.Max() + TreeLayout.EntityWidth + TreeLayout.Margin - left, ys.Max() + TreeLayout.EntityHeight + TreeLayout.Margin - top, rect.Width, rect.Height);
    }

    private void StartPan(PointerEventArgs e)
    {
        if (e.Button == 0) BeginDrag(Drag.Pan, e);
    }

    private void StartEntityDrag(EntityId id, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        draggedEntity = id;
        BeginDrag(Drag.Entity, e);
    }

    private void BeginDrag(Drag kind, PointerEventArgs e)
    {
        drag = kind;
        lastX = e.ClientX;
        lastY = e.ClientY;
        dragMoved = false;
        suppressClick = false;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (drag == Drag.None) return;
        if ((e.Buttons & 1) == 0) { EndDrag(); return; }   // the button was released where we could not see it
        if (!dragMoved)
        {
            if (double.Hypot(e.ClientX - lastX, e.ClientY - lastY) < DragThreshold) return;
            dragMoved = true;
        }
        double dx = e.ClientX - lastX, dy = e.ClientY - lastY;
        lastX = e.ClientX;
        lastY = e.ClientY;
        if (drag == Drag.Pan)
        {
            viewport = viewport.PanBy(dx, dy);
            return;
        }
        var current = nudges.GetValueOrDefault(draggedEntity);
        nudges[draggedEntity] = new Nudge(current.X + dx / viewport.Scale, current.Y + dy / viewport.Scale);   // the pointer moves in screen pixels, the entity in world units
        ApplyNudges();
    }

    // Leaving the canvas ends the drag with no click to follow, so there is nothing to suppress.
    private void CancelDrag()
    {
        if (drag == Drag.Entity && dragMoved) unsaved = true;
        drag = Drag.None;
        suppressClick = false;
    }

    private void EndDrag()
    {
        suppressClick = dragMoved;
        if (drag == Drag.Entity && dragMoved) unsaved = true;
        drag = Drag.None;
    }

    private void RerunLayout()
    {
        Begin();
        if (nudges.Count == 0) return;
        nudges.Clear();
        ApplyNudges();
        unsaved = true;
    }

    private void ApplyNudges()
    {
        foreach (var id in nudges.Keys.Where(id => !baseLayout.Positions.ContainsKey(id)).ToList()) nudges.Remove(id);
        placement = baseLayout with
        {
            Positions = baseLayout.Positions.ToDictionary(p => p.Key, p => nudges.TryGetValue(p.Key, out var n) ? (p.Value.X + n.X, p.Value.Y + n.Y) : p.Value)
        };
    }

    // An entity, a junction and a link are never selected together.
    private void ClearSelection() { selected = null; selectedJunction = null; selectedLink = null; selectedGhost = null; }
    private void Refresh()
    {
        unsaved = true;
        baseLayout = TreeLayout.Compute(tree);
        ApplyNudges();
        report = tree.Report();
    }
}
