@page "/"
@using TocBuilder.Domain
@inject TreeLibrary Library

<PageTitle>TOC Builder</PageTitle>

<div class="editor">
    <div class="library" role="group" aria-label="Trees">
        <select value="@currentId" @onchange="OpenTree" aria-label="Open tree">
            @foreach (var saved in trees)
            {
                <option value="@saved.Id">@saved.Name</option>
            }
        </select>
        <input @key="(editRevision, 2)" value="@treeName" @onchange="RenameTree" aria-label="Tree name" />
        <button type="button" @onclick="NewTree">New tree</button>
        @if (confirmingDelete)
        {
            <button type="button" @onclick="DeleteTree">Confirm delete</button>
            <button type="button" @onclick="() => confirmingDelete = false">Cancel</button>
        }
        else
        {
            <button type="button" @onclick="() => confirmingDelete = true">Delete tree</button>
        }
        <button type="button" @onclick="ExportTree">Export JSON</button>
        <label class="import">Import JSON <InputFile OnChange="ImportTree" accept=".json,application/json" /></label>
    </div>

    <form class="add" @onsubmit="AddEntity">
        <input @bind="statement" @bind:event="oninput" placeholder="Describe an entity, e.g. an undesirable effect" size="52" aria-label="Entity statement" />
        <button type="submit">Add entity</button>
    </form>

    <div class="toolbar">
        <button type="button" @onclick="Undo" disabled="@(!tree.CanUndo)">Undo (Ctrl+Z)</button>
        <button type="button" @onclick="Redo" disabled="@(!tree.CanRedo)">Redo (Ctrl+Shift+Z)</button>
        <button type="button" @onclick="AddCause" disabled="@(selected is null)">Add cause (Tab)</button>
        <button type="button" @onclick="AddEffect" disabled="@(selected is null)">Add effect</button>
        <button type="button" @onclick="ToggleLinking" disabled="@(selected is null)" aria-pressed="@(linking ? "true" : "false")">Link: selected is a cause of…</button>
        <button type="button" @onclick="StartGrouping" disabled="@(selected is null)" aria-pressed="@(junctionMode == JunctionMode.Grouping ? "true" : "false")">AND-group causes…</button>
        @if (junctionMode == JunctionMode.Grouping)
        {
            <button type="button" @onclick="ApplyGrouping" disabled="@(groupMembers.Count < 2)">Apply AND-group (@groupMembers.Count)</button>
        }
        <button type="button" @onclick="DeleteSelected" disabled="@(selected is null && selectedJunction is null)">Delete (Del)</button>
        @if (selectedJunction is not null)
        {
            <button type="button" @onclick="() => StartJunctionMode(JunctionMode.Adding)" aria-pressed="@(junctionMode == JunctionMode.Adding ? "true" : "false")">Add cause to AND…</button>
            <button type="button" @onclick="() => StartJunctionMode(JunctionMode.Removing)" aria-pressed="@(junctionMode == JunctionMode.Removing ? "true" : "false")">Remove cause from AND…</button>
            <button type="button" @onclick="Ungroup">Ungroup</button>
        }
        @if (SelectedEntity is { } current)
        {
            <input class="edit" @key="(editRevision, 0)" value="@current.Statement" @onchange="EditSelected" size="40" aria-label="Selected entity statement" />
            <select @key="(editRevision, 1)" value="@current.Tag" @onchange="TagSelected" aria-label="Selected entity tag">
                <option value="@EntityTag.None">No tag</option>
                <option value="@EntityTag.Ude">UDE</option>
                <option value="@EntityTag.CoreProblem">Core problem</option>
            </select>
        }
        <span class="message @(messageIsError ? "error" : "")" role="status">@message</span>
    </div>

    <div class="workspace">
    <div class="canvas" tabindex="0" @ref="canvasRef" @onkeydown="OnKeyDown" @onkeydown:preventDefault="@(selected is not null)">
        @if (tree.Entities.Count == 0)
        {
            <p class="empty">Add a first entity to begin.</p>
        }
        else
        {
            <svg width="@placement.Width" height="@placement.Height" xmlns="http://www.w3.org/2000/svg" @onclick="Deselect">
                <defs>
                    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M0,0 L10,5 L0,10 z" fill="#555" />
                    </marker>
                </defs>
                @foreach (var link in tree.Links)
                {
                    var linkSelected = selectedLink == link;
                    <g @onclick="() => SelectLink(link)" @onclick:stopPropagation style="cursor:pointer" aria-label="Causal link">
                        <path d="@placement.LinkPath(link)" fill="none" stroke="transparent" stroke-width="14" />
                        <path d="@placement.LinkPath(link)" fill="none" stroke="@(linkSelected ? SelectionColour : "#555")" stroke-width="@(linkSelected ? 3 : 1.5)" marker-end="url(#arrow)" />
                    </g>
                }
                @foreach (var junction in tree.Junctions)
                {
                    var (arc, labelX, labelY) = placement.JunctionArc(junction);
                    var junctionSelected = selectedJunction == junction.Id;
                    var colour = junctionSelected ? SelectionColour : JunctionColour;
                    <g @onclick="() => SelectJunction(junction.Id)" @onclick:stopPropagation style="cursor:pointer" aria-label="AND-junction">
                        <path d="@arc" fill="none" stroke="transparent" stroke-width="14" />
                        <path d="@arc" fill="none" stroke="@colour" stroke-width="4" stroke-linecap="round" />
                        <text x="@labelX" y="@labelY" text-anchor="middle" font-size="10" font-weight="bold" font-family="sans-serif" fill="@colour">AND</text>
                    </g>
                }
                @foreach (var entity in tree.Entities)
                {
                    var (x, y) = placement.Positions[entity.Id];
                    var isSelected = selected == entity.Id;
                    <g @onclick="() => Select(entity.Id)" @onclick:stopPropagation style="cursor:pointer">
                        <rect x="@x" y="@y" width="@TreeLayout.EntityWidth" height="@TreeLayout.EntityHeight" rx="6"
                              fill="#f4f6fa" stroke="@(isSelected ? SelectionColour : groupMembers.Contains(entity.Id) ? JunctionColour : "#888")" stroke-width="@(isSelected || groupMembers.Contains(entity.Id) ? 3 : 1.2)" />
                        <text x="@(x + 6)" y="@(y - 4)" font-size="11" font-weight="bold" font-family="sans-serif" fill="@(entity.Tag == EntityTag.Ude ? "#b71c1c" : "#1b5e20")">@TagLabel(entity.Tag)</text>
                        <text x="@(x + TreeLayout.EntityWidth / 2)" y="@(y + TreeLayout.EntityHeight / 2 + 4)" text-anchor="middle" font-size="12" font-family="sans-serif">@TruncateForDisplay(entity.Statement)</text>
                    </g>
                }
            </svg>
        }
    </div>

    <aside class="summary" aria-label="Tree summary">
        <h2>Tree summary</h2>
        @SummarySection("UDEs with no path to a Core problem", summary.UdesWithoutCoreProblem)
        @SummarySection("Core problems that explain no UDE", summary.CoreProblemsExplainingNoUde)
        @SummarySection("Unconnected entities", summary.UnconnectedEntities)
        @SummarySection("Root causes", summary.RootCauses)
        <section>
            <h3>Open reservations (@summary.OpenReservations.Count)</h3>
            @if (summary.OpenReservations.Count > 0)
            {
                <ul>
                    @foreach (var reservation in summary.OpenReservations)
                    {
                        <li>
                            <button type="button" class="link" @onclick="() => SelectTarget(reservation.Target)">@CategoryLabel(reservation.Category): @Describe(reservation.Target)</button>
                            @if (reservation.Note != "") { <span class="note"> – @reservation.Note</span> }
                        </li>
                    }
                </ul>
            }
        </section>
        @if (CurrentTarget is { } target)
        {
            <section class="reservations" aria-label="Reservations">
                <h2>Reservations</h2>
                <p class="target">@Describe(target)</p>
                <ul>
                    @foreach (var category in Enum.GetValues<ClrCategory>())
                    {
                        var existing = tree.Reservations.FirstOrDefault(r => r.Target == target && r.Category == category);
                        <li>
                            <span class="category">@CategoryLabel(category)</span>
                            @if (existing is null)
                            {
                                <button type="button" @onclick="() => Raise(target, category)">Raise</button>
                            }
                            else
                            {
                                <select @key="(editRevision, existing.Id, 0)" value="@existing.State" @onchange="e => ChangeReservationState(existing.Id, e)" aria-label="@(CategoryLabel(category) + " state")">
                                    <option value="@ReservationState.Open">Open</option>
                                    <option value="@ReservationState.Resolved">Resolved</option>
                                    <option value="@ReservationState.Dismissed">Dismissed</option>
                                </select>
                                <input @key="(editRevision, existing.Id, 1)" value="@existing.Note" @onchange="e => ChangeReservationNote(existing.Id, e)" placeholder="Note" aria-label="@(CategoryLabel(category) + " note")" />
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </aside>
    </div>
</div>

@code {
    private Tree tree = new();
    private TreeLayout.Result placement = TreeLayout.Compute(new Tree());
    private EntityId? selected;
    private bool linking;
    private enum JunctionMode { None, Grouping, Adding, Removing }
    private JunctionMode junctionMode;
    private readonly HashSet<EntityId> groupMembers = [];
    private JunctionId? selectedJunction;
    private CausalLink? selectedLink;
    private string statement = "";
    private string message = "";
    private bool messageIsError;
    private int editRevision;   // changing it replaces the edit box, so it shows the kept statement again
    private ElementReference canvasRef;
    private bool focusCanvas;

    private const string JunctionColour = "#e65100";
    private const string SelectionColour = "#1565c0";   // keep in step with --selection in app.css
    private const int MaxDisplayedStatement = 22;

    private TreeSummary summary = new Tree().Summarise();

    private List<SavedTree> trees = [];
    private string currentId = "";
    private string treeName = "";
    private bool confirmingDelete;
    private bool unsaved;   // set by Refresh after a change, saved once the page has rendered

    protected override async Task OnInitializedAsync()
    {
        trees = await Library.ListAsync();
        var preferred = await Library.CurrentIdAsync();
        var candidates = trees.OrderBy(t => t.Id == preferred ? 0 : 1).ToList();
        foreach (var candidate in candidates)
        {
            if (await TryOpen(candidate)) return;
        }
        await CreateTree("Untitled tree");
    }

    private async Task<bool> TryOpen(SavedTree saved)
    {
        var result = await Library.LoadAsync(saved.Id);
        if (result.Tree is null)
        {
            Report($"Could not open \"{saved.Name}\": {result.Message}", isError: true);
            return false;
        }
        Show(saved.Id, saved.Name, result.Tree);
        await Library.SetCurrentAsync(saved.Id);
        return true;
    }

    // Swaps the open tree. The new tree is already stored, so nothing is saved.
    private void Show(string id, string name, Tree opened)
    {
        tree = opened;
        currentId = id;
        treeName = name;
        confirmingDelete = false;
        ClearSelection();
        ClearModes();
        statement = "";
        editRevision++;
        Refresh();
        unsaved = false;
    }

    private async Task CreateTree(string name, Tree? content = null)
    {
        var id = Guid.NewGuid().ToString("N");
        var created = content ?? new Tree();
        await Library.SaveAsync(id, name, created);
        trees = await Library.ListAsync();
        Show(id, name, created);
        await Library.SetCurrentAsync(id);
    }

    private async Task NewTree()
    {
        await SaveIfNeeded();
        Begin();
        await CreateTree("Untitled tree");
    }

    private async Task OpenTree(ChangeEventArgs e)
    {
        await SaveIfNeeded();
        Begin();
        var saved = trees.FirstOrDefault(t => t.Id == e.Value?.ToString());
        if (saved is not null) await TryOpen(saved);
        editRevision++;   // if opening failed, the list must show the tree that is still open
    }

    private async Task RenameTree(ChangeEventArgs e)
    {
        Begin();
        var name = e.Value?.ToString()?.Trim() ?? "";
        if (name == "")
        {
            Report("A tree needs a name.", isError: true);
            editRevision++;
            return;
        }
        treeName = name;
        await Library.SaveAsync(currentId, treeName, tree);
        trees = await Library.ListAsync();
    }

    private async Task DeleteTree()
    {
        Begin();
        await Library.DeleteAsync(currentId);
        trees = await Library.ListAsync();
        foreach (var remaining in trees)
        {
            if (await TryOpen(remaining)) return;
        }
        await CreateTree("Untitled tree");
    }

    private async Task ExportTree()
    {
        Begin();
        var fileName = string.Concat(treeName.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c)) + ".toc.json";
        await Library.DownloadAsync(fileName, TreeSerializer.Export(treeName, tree));
    }

    // A refused file never touches the open tree: nothing changes until the import has succeeded.
    private async Task ImportTree(InputFileChangeEventArgs e)
    {
        Begin();
        string json;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
            json = await reader.ReadToEndAsync();
        }
        catch (IOException ex)
        {
            Report($"Could not read the file: {ex.Message}", isError: true);
            return;
        }
        var result = TreeSerializer.Import(json);
        if (result.Tree is null)
        {
            Report(result.Message ?? "The file could not be imported.", isError: true);
            return;
        }
        await SaveIfNeeded();
        await CreateTree(result.Name ?? "Imported tree", result.Tree);
        Report($"Imported \"{treeName}\".");
    }

    private async Task SaveIfNeeded()
    {
        if (!unsaved) return;
        unsaved = false;
        try
        {
            await Library.SaveAsync(currentId, treeName, tree);
        }
        catch (JSException ex)   // e.g. storage full or disabled; the next change tries again (leaving the flag set would retry on every render)
        {
            Report($"Could not save to this browser: {ex.Message} Export the tree to keep it.", isError: true);
            StateHasChanged();
        }
    }

    private static string TagLabel(EntityTag tag) => tag switch { EntityTag.Ude => "UDE", EntityTag.CoreProblem => "CORE PROBLEM", _ => "" };

    private RenderFragment SummarySection(string title, IReadOnlyList<Entity> entities) => @<section>
        <h3>@title (@entities.Count)</h3>
        @if (entities.Count > 0)
        {
            <ul>
                @foreach (var entity in entities)
                {
                    <li><button type="button" class="link" @onclick="() => Select(entity.Id)">@entity.Statement</button></li>
                }
            </ul>
        }
    </section>;

    private Entity? SelectedEntity => selected is { } id ? tree.Entities.First(e => e.Id == id) : null;

    private ReservationTarget? CurrentTarget =>
        selectedJunction is { } junction ? new OnJunction(junction)
        : selectedLink is { } link ? new OnLink(link)
        : selected is { } entity ? new OnEntity(entity)
        : null;

    private string StatementOf(EntityId id) => tree.Entities.First(e => e.Id == id).Statement;

    private string Describe(ReservationTarget target) => target switch
    {
        OnEntity entity => StatementOf(entity.Entity),
        OnLink link => $"{StatementOf(link.Link.Cause)} → {StatementOf(link.Link.Effect)}",
        OnJunction junction => DescribeJunction(tree.Junctions.First(j => j.Id == junction.Junction)),
        _ => throw new InvalidOperationException($"Unhandled reservation target {target.GetType().Name}.")
    };

    private string DescribeJunction(AndJunction junction) =>
        $"AND of {string.Join(" + ", junction.Causes.Select(StatementOf))} → {StatementOf(junction.Effect)}";

    private static string CategoryLabel(ClrCategory category) => category switch
    {
        ClrCategory.Clarity => "Clarity",
        ClrCategory.EntityExistence => "Entity existence",
        ClrCategory.CausalityExistence => "Causality existence",
        ClrCategory.CauseInsufficiency => "Cause insufficiency",
        ClrCategory.AdditionalCause => "Additional cause",
        ClrCategory.CauseEffectReversal => "Cause-effect reversal",
        ClrCategory.PredictedEffectExistence => "Predicted effect existence",
        ClrCategory.Tautology => "Tautology",
        _ => throw new InvalidOperationException($"Unhandled CLR category {category}.")
    };

    private static string TruncateForDisplay(string text) =>
        text.Length > MaxDisplayedStatement ? text[..(MaxDisplayedStatement - 1)] + "…" : text;

    // The text typed in the "add entity" box names the next entity added, otherwise the default is used.
    private string TakeStatement(string fallback)
    {
        var text = string.IsNullOrWhiteSpace(statement) ? fallback : statement;
        statement = "";
        return text;
    }

    private void AddEntity()
    {
        if (string.IsNullOrWhiteSpace(statement)) return;
        Begin();
        SelectNew(tree.AddEntity(TakeStatement("")));
    }

    private void AddCause()
    {
        if (selected is not { } effect) return;
        Begin();
        SelectNew(tree.AddCause(effect, TakeStatement("New cause")));
    }

    private void AddEffect()
    {
        if (selected is not { } cause) return;
        Begin();
        SelectNew(tree.AddEffect(cause, TakeStatement("New effect")));
    }

    private void DeleteSelected()
    {
        if (selected is null) { Ungroup(); return; }
        var id = selected.Value;
        Begin();
        tree.Delete(id);
        selected = null;
        ClearModes();
        Refresh();
        focusCanvas = true;
    }

    private void EditSelected(ChangeEventArgs e)
    {
        if (selected is not { } id) return;
        Begin();
        var text = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(text))
        {
            Report("A statement cannot be blank; the previous one was kept.", isError: true);
            editRevision++;
            return;
        }
        tree.EditStatement(id, text);
        Refresh();
    }

    private void TagSelected(ChangeEventArgs e)
    {
        if (selected is not { } id || !Enum.TryParse<EntityTag>(e.Value?.ToString(), out var tag)) return;
        Begin();
        tree.SetTag(id, tag);
        Refresh();
    }

    private void Raise(ReservationTarget target, ClrCategory category)
    {
        Begin();
        tree.RaiseReservation(target, category);
        Refresh();
    }

    private void ChangeReservationState(ReservationId id, ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReservationState>(e.Value?.ToString(), out var state)) return;
        Begin();
        tree.SetReservationState(id, state);
        Refresh();
    }

    private void ChangeReservationNote(ReservationId id, ChangeEventArgs e)
    {
        Begin();
        tree.SetReservationNote(id, e.Value?.ToString() ?? "");
        Refresh();
    }

    private void SelectLink(CausalLink link)
    {
        Begin();
        ClearModes();
        ClearSelection();
        selectedLink = link;
        focusCanvas = true;
    }

    private void SelectTarget(ReservationTarget target)
    {
        Begin();
        ClearModes();
        ClearSelection();
        switch (target)
        {
            case OnEntity entity: selected = entity.Entity; break;
            case OnLink link: selectedLink = link.Link; break;
            case OnJunction junction: selectedJunction = junction.Junction; break;
        }
        focusCanvas = true;
    }

    private void Undo() => Travel(tree.Undo());
    private void Redo() => Travel(tree.Redo());

    private void Travel(bool changed)
    {
        Begin();
        if (!changed) return;
        if (selected is { } id && tree.Entities.All(e => e.Id != id)) selected = null;   // the selected entity may not exist in the restored tree
        ClearModes();
        if (selectedJunction is { } junction && tree.Junctions.All(j => j.Id != junction)) selectedJunction = null;
        if (selectedLink is { } link && !tree.Links.Contains(link)) selectedLink = null;
        editRevision++;   // the kept statement may differ after the restore, so rebuild the edit box
        Refresh();
        focusCanvas = true;
    }

    private void ToggleLinking()
    {
        Begin();
        var wasLinking = linking;
        ClearModes();
        linking = !wasLinking;
        if (linking) Report("Click the entity it is a cause of, or press Escape to cancel.");
        focusCanvas = true;
    }

    private void Select(EntityId id)
    {
        if (linking && selected is not null) { LinkSelectedTo(id); return; }   // linking an entity to itself is reported as a cycle
        if (junctionMode == JunctionMode.Grouping && selected is { } effect)
        {
            if (id != effect && !groupMembers.Remove(id)) groupMembers.Add(id);
            return;
        }
        if (selectedJunction is { } junction && junctionMode != JunctionMode.None) { ChangeJunction(junction, id); return; }
        ClearModes();
        ClearSelection();
        selected = id;
    }

    private void SelectJunction(JunctionId id)
    {
        Begin();
        ClearModes();
        ClearSelection();
        selectedJunction = id;
        focusCanvas = true;
    }

    private void StartGrouping()
    {
        if (selected is null) return;
        Begin();
        var wasGrouping = junctionMode == JunctionMode.Grouping;
        ClearModes();
        if (wasGrouping) return;
        junctionMode = JunctionMode.Grouping;
        Report("Click two or more causes of the selected entity, then apply. Escape cancels.");
        focusCanvas = true;
    }

    private void ApplyGrouping()
    {
        if (selected is not { } effect) return;
        Begin();
        var result = tree.Group(effect, [.. groupMembers]);
        if (result.Outcome != JunctionOutcome.Done) { Report(Explain(result.Outcome), isError: true); return; }
        ClearModes();
        selected = null;
        selectedJunction = result.Junction!.Id;
        Report("Grouped.");
        Refresh();
        focusCanvas = true;
    }

    private void StartJunctionMode(JunctionMode mode)
    {
        Begin();
        var wasMode = junctionMode;
        ClearModes();
        if (wasMode == mode) return;
        junctionMode = mode;
        Report(mode == JunctionMode.Adding ? "Click the entity to add as a cause to this AND-junction." : "Click the cause to take out of this AND-junction.");
        focusCanvas = true;
    }

    private void ChangeJunction(JunctionId junction, EntityId entity)
    {
        Begin();
        if (junctionMode == JunctionMode.Removing)
        {
            if (!tree.Junctions.First(j => j.Id == junction).Causes.Contains(entity)) { Report("That entity is not in this AND-junction.", isError: true); return; }
            tree.RemoveFromJunction(junction, entity);
            if (tree.Junctions.All(j => j.Id != junction)) selectedJunction = null;   // left with one cause, so it dissolved
            Report("Removed from the AND-junction.");
        }
        else
        {
            var outcome = tree.AddToJunction(junction, entity);
            if (outcome != JunctionOutcome.Done) { Report(Explain(outcome), isError: true); return; }
            Report("Added to the AND-junction.");
        }
        ClearModes();
        Refresh();
    }

    private void Ungroup()
    {
        if (selectedJunction is not { } id) return;
        Begin();
        tree.Ungroup(id);
        selectedJunction = null;
        ClearModes();
        Refresh();
        focusCanvas = true;
    }

    private static string Explain(JunctionOutcome outcome) => outcome switch
    {
        JunctionOutcome.TooFewCauses => "An AND-junction needs at least two causes.",
        JunctionOutcome.NotACauseOfEffect => "Every grouped entity must already be a cause of the selected entity.",
        JunctionOutcome.AlreadyInJunction => "That cause is already in an AND-junction for this effect.",
        JunctionOutcome.WouldCreateCycle => "Rejected: that would create a cycle.",
        _ => throw new InvalidOperationException($"Unhandled junction outcome {outcome}.")
    };

    private void ClearModes()
    {
        linking = false;
        junctionMode = JunctionMode.None;
        groupMembers.Clear();
    }

    private void LinkSelectedTo(EntityId effect)
    {
        Begin();
        var outcome = tree.Link(selected!.Value, effect);
        switch (outcome)
        {
            case LinkOutcome.Linked: Report("Linked."); break;
            case LinkOutcome.AlreadyLinked: Report("Those entities are already linked."); break;
            case LinkOutcome.WouldCreateCycle: Report("Rejected: that link would create a cycle.", isError: true); break;
            default: throw new InvalidOperationException($"Unhandled link outcome {outcome}.");
        }
        Refresh();
        ClearModes();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            switch (e.Key.ToLowerInvariant())
            {
                case "z" when e.ShiftKey: Redo(); break;
                case "z": Undo(); break;
                case "y": Redo(); break;
                default: return;
            }
            return;
        }
        switch (e.Key)
        {
            case "Tab": AddCause(); break;
            case "Delete": DeleteSelected(); break;
            case "Escape" when linking || junctionMode != JunctionMode.None: ClearModes(); Report(""); break;
            case "Escape": ClearSelection(); break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SaveIfNeeded();
        if (!focusCanvas) return;
        focusCanvas = false;
        await canvasRef.FocusAsync();
    }

    private void Begin() => Report("");

    private void Report(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }

    private void SelectNew(Entity entity)
    {
        ClearSelection();
        selected = entity.Id;
        ClearModes();
        Refresh();
        focusCanvas = true;   // so the keyboard can keep building straight away
    }

    private void Deselect() { ClearSelection(); ClearModes(); }

    // An entity, a junction and a link are never selected together.
    private void ClearSelection() { selected = null; selectedJunction = null; selectedLink = null; }
    private void Refresh()
    {
        unsaved = true;
        placement = TreeLayout.Compute(tree);
        summary = tree.Summarise();
    }
}
