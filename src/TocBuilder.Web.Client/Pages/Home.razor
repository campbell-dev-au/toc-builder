@page "/"
@using TocBuilder.Domain

<PageTitle>TOC Builder</PageTitle>

<div class="editor">
    <form class="add" @onsubmit="AddEntity">
        <input @bind="statement" @bind:event="oninput" placeholder="Describe an entity, e.g. an undesirable effect" size="52" aria-label="Entity statement" />
        <button type="submit">Add entity</button>
    </form>

    <div class="toolbar">
        <button type="button" @onclick="Undo" disabled="@(!tree.CanUndo)">Undo (Ctrl+Z)</button>
        <button type="button" @onclick="Redo" disabled="@(!tree.CanRedo)">Redo (Ctrl+Shift+Z)</button>
        <button type="button" @onclick="AddCause" disabled="@(selected is null)">Add cause (Tab)</button>
        <button type="button" @onclick="AddEffect" disabled="@(selected is null)">Add effect</button>
        <button type="button" @onclick="ToggleLinking" disabled="@(selected is null)" aria-pressed="@(linking ? "true" : "false")">Link: selected is a cause of…</button>
        <button type="button" @onclick="DeleteSelected" disabled="@(selected is null)">Delete (Del)</button>
        @if (SelectedEntity is { } current)
        {
            <input class="edit" @key="editRevision" value="@current.Statement" @onchange="EditSelected" size="40" aria-label="Selected entity statement" />
            <select @key="editRevision" value="@current.Tag" @onchange="TagSelected" aria-label="Selected entity tag">
                <option value="@EntityTag.None">No tag</option>
                <option value="@EntityTag.Ude">UDE</option>
                <option value="@EntityTag.CoreProblem">Core problem</option>
            </select>
        }
        <span class="message @(messageIsError ? "error" : "")" role="status">@message</span>
    </div>

    <div class="workspace">
    <div class="canvas" tabindex="0" @ref="canvasRef" @onkeydown="OnKeyDown" @onkeydown:preventDefault="@(selected is not null)">
        @if (tree.Entities.Count == 0)
        {
            <p class="empty">Add a first entity to begin.</p>
        }
        else
        {
            <svg width="@placement.Width" height="@placement.Height" xmlns="http://www.w3.org/2000/svg" @onclick="Deselect">
                <defs>
                    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M0,0 L10,5 L0,10 z" fill="#555" />
                    </marker>
                </defs>
                @foreach (var link in tree.Links)
                {
                    <path d="@placement.LinkPath(link)" fill="none" stroke="#555" stroke-width="1.5" marker-end="url(#arrow)" />
                }
                @foreach (var entity in tree.Entities)
                {
                    var (x, y) = placement.Positions[entity.Id];
                    var isSelected = selected == entity.Id;
                    <g @onclick="() => Select(entity.Id)" @onclick:stopPropagation style="cursor:pointer">
                        <rect x="@x" y="@y" width="@TreeLayout.EntityWidth" height="@TreeLayout.EntityHeight" rx="6"
                              fill="#f4f6fa" stroke="@(isSelected ? SelectionColour : "#888")" stroke-width="@(isSelected ? 3 : 1.2)" />
                        <text x="@(x + 6)" y="@(y - 4)" font-size="11" font-weight="bold" font-family="sans-serif" fill="@(entity.Tag == EntityTag.Ude ? "#b71c1c" : "#1b5e20")">@TagLabel(entity.Tag)</text>
                        <text x="@(x + TreeLayout.EntityWidth / 2)" y="@(y + TreeLayout.EntityHeight / 2 + 4)" text-anchor="middle" font-size="12" font-family="sans-serif">@TruncateForDisplay(entity.Statement)</text>
                    </g>
                }
            </svg>
        }
    </div>

    <aside class="summary" aria-label="Tree summary">
        <h2>Tree summary</h2>
        @SummarySection("UDEs with no path to a Core problem", summary.UdesWithoutCoreProblem)
        @SummarySection("Core problems that explain no UDE", summary.CoreProblemsExplainingNoUde)
        @SummarySection("Unconnected entities", summary.UnconnectedEntities)
        @SummarySection("Root causes", summary.RootCauses)
    </aside>
    </div>
</div>

@code {
    private readonly Tree tree = new();
    private TreeLayout.Result placement = TreeLayout.Compute(new Tree());
    private EntityId? selected;
    private bool linking;
    private string statement = "";
    private string message = "";
    private bool messageIsError;
    private int editRevision;   // changing it replaces the edit box, so it shows the kept statement again
    private ElementReference canvasRef;
    private bool focusCanvas;

    private const string SelectionColour = "#1565c0";   // keep in step with --selection in app.css
    private const int MaxDisplayedStatement = 22;

    private TreeSummary summary = new Tree().Summarise();

    private static string TagLabel(EntityTag tag) => tag switch { EntityTag.Ude => "UDE", EntityTag.CoreProblem => "CORE PROBLEM", _ => "" };

    private RenderFragment SummarySection(string title, IReadOnlyList<Entity> entities) => @<section>
        <h3>@title (@entities.Count)</h3>
        @if (entities.Count > 0)
        {
            <ul>
                @foreach (var entity in entities)
                {
                    <li><button type="button" class="link" @onclick="() => Select(entity.Id)">@entity.Statement</button></li>
                }
            </ul>
        }
    </section>;

    private Entity? SelectedEntity => selected is { } id ? tree.Entities.First(e => e.Id == id) : null;

    private static string TruncateForDisplay(string text) =>
        text.Length > MaxDisplayedStatement ? text[..(MaxDisplayedStatement - 1)] + "…" : text;

    // The text typed in the "add entity" box names the next entity added, otherwise the default is used.
    private string TakeStatement(string fallback)
    {
        var text = string.IsNullOrWhiteSpace(statement) ? fallback : statement;
        statement = "";
        return text;
    }

    private void AddEntity()
    {
        if (string.IsNullOrWhiteSpace(statement)) return;
        Begin();
        SelectNew(tree.AddEntity(TakeStatement("")));
    }

    private void AddCause()
    {
        if (selected is not { } effect) return;
        Begin();
        SelectNew(tree.AddCause(effect, TakeStatement("New cause")));
    }

    private void AddEffect()
    {
        if (selected is not { } cause) return;
        Begin();
        SelectNew(tree.AddEffect(cause, TakeStatement("New effect")));
    }

    private void DeleteSelected()
    {
        if (selected is not { } id) return;
        Begin();
        tree.Delete(id);
        selected = null;
        linking = false;
        Refresh();
        focusCanvas = true;
    }

    private void EditSelected(ChangeEventArgs e)
    {
        if (selected is not { } id) return;
        Begin();
        var text = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(text))
        {
            Report("A statement cannot be blank; the previous one was kept.", isError: true);
            editRevision++;
            return;
        }
        tree.EditStatement(id, text);
        Refresh();
    }

    private void TagSelected(ChangeEventArgs e)
    {
        if (selected is not { } id || !Enum.TryParse<EntityTag>(e.Value?.ToString(), out var tag)) return;
        Begin();
        tree.SetTag(id, tag);
        Refresh();
    }

    private void Undo() => Travel(tree.Undo());
    private void Redo() => Travel(tree.Redo());

    private void Travel(bool changed)
    {
        Begin();
        if (!changed) return;
        if (selected is { } id && tree.Entities.All(e => e.Id != id)) selected = null;   // the selected entity may not exist in the restored tree
        linking = false;
        editRevision++;   // the kept statement may differ after the restore, so rebuild the edit box
        Refresh();
        focusCanvas = true;
    }

    private void ToggleLinking()
    {
        Begin();
        linking = !linking;
        if (linking) Report("Click the entity it is a cause of, or press Escape to cancel.");
        focusCanvas = true;
    }

    private void Select(EntityId id)
    {
        if (linking && selected is not null) { LinkSelectedTo(id); return; }   // linking an entity to itself is reported as a cycle
        linking = false;
        selected = id;
    }

    private void LinkSelectedTo(EntityId effect)
    {
        Begin();
        var outcome = tree.Link(selected!.Value, effect);
        switch (outcome)
        {
            case LinkOutcome.Linked: Report("Linked."); break;
            case LinkOutcome.AlreadyLinked: Report("Those entities are already linked."); break;
            case LinkOutcome.WouldCreateCycle: Report("Rejected: that link would create a cycle.", isError: true); break;
            default: throw new InvalidOperationException($"Unhandled link outcome {outcome}.");
        }
        Refresh();
        linking = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            switch (e.Key.ToLowerInvariant())
            {
                case "z" when e.ShiftKey: Redo(); break;
                case "z": Undo(); break;
                case "y": Redo(); break;
                default: return;
            }
            return;
        }
        switch (e.Key)
        {
            case "Tab": AddCause(); break;
            case "Delete": DeleteSelected(); break;
            case "Escape" when linking: linking = false; Report(""); break;
            case "Escape": selected = null; break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusCanvas) return;
        focusCanvas = false;
        await canvasRef.FocusAsync();
    }

    private void Begin() => Report("");

    private void Report(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }

    private void SelectNew(Entity entity)
    {
        selected = entity.Id;
        linking = false;
        Refresh();
        focusCanvas = true;   // so the keyboard can keep building straight away
    }

    private void Deselect() { selected = null; linking = false; }
    private void Refresh()
    {
        placement = TreeLayout.Compute(tree);
        summary = tree.Summarise();
    }
}
