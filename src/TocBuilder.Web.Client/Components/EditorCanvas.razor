@using TocBuilder.Domain

<div class="canvas" tabindex="0" @ref="canvas" @onkeydown="OnKeyDown" @onkeydown:preventDefault="@HasSelection"
     @onwheel="OnWheel" @onwheel:preventDefault @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointerleave="OnPointerLeave">
    @if (Tree.Entities.Count == 0)
    {
        <p class="empty">Add a first entity to begin.</p>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" @onclick="OnDeselect" @onpointerdown="OnStartPan">
            <defs>
                <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#555" />
                </marker>
            </defs>
            <g transform="translate(@Num(Math.Round(Viewport.PanX)) @Num(Math.Round(Viewport.PanY))) scale(@Num(Viewport.Scale))">
            @foreach (var link in Tree.Links)
            {
                var linkSelected = SelectedLink == link;
                <g @onclick="() => { if (!ConsumeSuppressedClick()) OnSelectLink.InvokeAsync(link); }" @onclick:stopPropagation style="cursor:pointer" aria-label="Causal link">
                    <path d="@Placement.LinkPath(link)" fill="none" stroke="transparent" stroke-width="14" />
                    <path d="@Placement.LinkPath(link)" fill="none" stroke="@(linkSelected ? SelectionColour : "#555")" stroke-width="@(linkSelected ? 3 : 1.5)" marker-end="url(#arrow)" />
                </g>
            }
            @foreach (var junction in Tree.Junctions)
            {
                var (arc, labelX, labelY) = Placement.JunctionArc(junction);
                var junctionSelected = SelectedJunction == junction.Id;
                var colour = junctionSelected ? SelectionColour : TreeSvg.JunctionColour;
                <g @onclick="() => { if (!ConsumeSuppressedClick()) OnSelectJunction.InvokeAsync(junction.Id); }" @onclick:stopPropagation style="cursor:pointer" aria-label="AND-junction">
                    <path d="@arc" fill="none" stroke="transparent" stroke-width="14" />
                    <path d="@arc" fill="none" stroke="@colour" stroke-width="4" stroke-linecap="round" />
                    <text x="@labelX" y="@labelY" text-anchor="middle" font-size="10" font-weight="bold" font-family="sans-serif" fill="@colour">AND</text>
                </g>
            }
            @foreach (var entity in Tree.Entities)
            {
                var (x, y) = Placement.Positions[entity.Id];
                var (w, h) = (Placement.WidthOf(entity.Id), Placement.HeightOf(entity.Id));
                var isSelected = Selected == entity.Id;
                <g @onclick="() => { if (!ConsumeSuppressedClick()) OnSelectEntity.InvokeAsync(entity.Id); }" @onclick:stopPropagation
                   @onpointerdown="e => OnStartEntityDrag.InvokeAsync((entity.Id, e))" @onpointerdown:stopPropagation style="cursor:pointer">
                    <title>@entity.Statement</title>
                    <rect x="@x" y="@y" width="@w" height="@h" rx="6"
                          fill="#f4f6fa" stroke="@(isSelected ? SelectionColour : GroupMembers.Contains(entity.Id) ? TreeSvg.JunctionColour : "#888")" stroke-width="@(isSelected || GroupMembers.Contains(entity.Id) ? 3 : 1.2)" />
                    <text x="@(x + 6)" y="@(y - 4)" font-size="11" font-weight="bold" font-family="sans-serif" fill="@(entity.Tag == EntityTag.Ude ? "#b71c1c" : "#1b5e20")">@TreeSvg.TagLabel(entity.Tag)</text>
                    <text x="@(x + w - 6)" y="@(y - 4)" text-anchor="end" font-size="11" font-family="sans-serif" fill="#555" data-testid="entity-code">@entity.Code</text>
                    @{ var lines = View == ViewMode.Text ? TreeSvg.WrapStatement(entity.Statement, TreeLayout.TextLineChars) : TreeSvg.DisplayLines(entity); }
                    <text x="@(x + w / 2)" y="@(View == ViewMode.Text ? y + TreeLayout.TextPadding : y + h / 2 + (lines.Count == 1 ? 4 : -2))" text-anchor="middle" font-size="12" font-family="sans-serif">
                        @for (var i = 0; i < lines.Count; i++)
                        {
                            <tspan x="@(x + w / 2)" dy="@(i == 0 ? 0 : TreeLayout.TextLineHeight)">@lines[i]</tspan>
                        }
                    </text>
                </g>
            }
            @if (Suggestions is not null && Placement.Positions.TryGetValue(GhostAnchor, out var anchor))
            {
                var ghosts = Suggestions.Pending;
                @for (var i = 0; i < ghosts.Count; i++)
                {
                    var ghost = ghosts[i];
                    var (gx, gy) = GhostPosition(anchor, ghost.Kind, i, ghosts.Count);
                    var picked = SelectedGhost == ghost;
                    var below = ghost.Kind != SuggestionKind.Effect;
                    var (fromX, fromY, toX, toY) = below
                        ? (gx + TreeLayout.EntityWidth / 2, gy, anchor.X + Placement.WidthOf(GhostAnchor) / 2, anchor.Y + Placement.HeightOf(GhostAnchor))
                        : (anchor.X + Placement.WidthOf(GhostAnchor) / 2, anchor.Y, gx + TreeLayout.EntityWidth / 2, gy + TreeLayout.EntityHeight);
                    <g @onclick="() => OnSelectGhost.InvokeAsync(ghost)" @onclick:stopPropagation @onpointerdown:stopPropagation style="cursor:pointer" aria-label="Suggestion" opacity="0.8">
                        <title>@ghost.Statement</title>
                        <path d="M@Num(fromX),@Num(fromY) L@Num(toX),@Num(toY)" fill="none" stroke="#777" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#arrow)" />
                        <rect x="@Num(gx)" y="@Num(gy)" width="@TreeLayout.EntityWidth" height="@TreeLayout.EntityHeight" rx="6"
                              fill="#fff" stroke="@(picked ? SelectionColour : "#777")" stroke-width="@(picked ? 3 : 1.5)" stroke-dasharray="6 4" />
                        @if (ghost.Existing is not null)
                        {
                            <g><text x="@Num(gx + 6)" y="@Num(gy - 4)" font-size="11" font-weight="bold" font-family="sans-serif" fill="#555">EXISTING</text></g>
                        }
                        <text x="@Num(gx + TreeLayout.EntityWidth / 2)" y="@Num(gy + TreeLayout.EntityHeight / 2 + 4)" text-anchor="middle" font-size="12" font-style="italic" font-family="sans-serif" fill="#555">@TreeSvg.TruncateForDisplay(ghost.Statement)</text>
                    </g>
                }
            }
            </g>
        </svg>
    }
</div>

@code {
    private const string SelectionColour = "#1565c0";   // keep in step with --selection in app.css

    private ElementReference canvas;

    [Parameter, EditorRequired] public Tree Tree { get; set; } = null!;
    [Parameter, EditorRequired] public TreeLayout.Result Placement { get; set; } = null!;
    [Parameter] public ViewMode View { get; set; }
    [Parameter] public Viewport Viewport { get; set; } = Viewport.Identity;
    [Parameter] public EntityId? Selected { get; set; }
    [Parameter] public JunctionId? SelectedJunction { get; set; }
    [Parameter] public CausalLink? SelectedLink { get; set; }
    [Parameter, EditorRequired] public IReadOnlySet<EntityId> GroupMembers { get; set; } = null!;
    [Parameter] public SuggestionSet? Suggestions { get; set; }
    [Parameter] public EntityId GhostAnchor { get; set; }
    [Parameter] public Suggestion? SelectedGhost { get; set; }
    [Parameter, EditorRequired] public Func<bool> ConsumeSuppressedClick { get; set; } = null!;   // the click that ends a drag must not select anything

    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback<WheelEventArgs> OnWheel { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnPointerMove { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnPointerUp { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnPointerLeave { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnStartPan { get; set; }
    [Parameter] public EventCallback<(EntityId Id, PointerEventArgs Args)> OnStartEntityDrag { get; set; }
    [Parameter] public EventCallback OnDeselect { get; set; }
    [Parameter] public EventCallback<EntityId> OnSelectEntity { get; set; }
    [Parameter] public EventCallback<CausalLink> OnSelectLink { get; set; }
    [Parameter] public EventCallback<JunctionId> OnSelectJunction { get; set; }
    [Parameter] public EventCallback<Suggestion> OnSelectGhost { get; set; }

    private bool HasSelection => Selected is not null;

    // The element itself, for the page to focus and to measure.
    public ElementReference Element => canvas;

    // Ghosts sit in a row of their own, centred on their Entity: below the whole tree for causes and above it for effects, so they never cover an Entity.
    private (double X, double Y) GhostPosition((double X, double Y) anchor, SuggestionKind kind, int index, int count)
    {
        var x = anchor.X + Placement.WidthOf(GhostAnchor) / 2 - TreeLayout.EntityWidth / 2 + (index - (count - 1) / 2.0) * (TreeLayout.EntityWidth + 30);
        var y = kind == SuggestionKind.Effect
            ? Placement.Positions.Values.Min(p => p.Y) - TreeLayout.EntityHeight - 60
            : Placement.Positions.Max(p => p.Value.Y + Placement.HeightOf(p.Key)) + 60;
        return (x, y);
    }

    // SVG attributes need invariant numbers whatever the browser's culture.
    private static string Num(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
