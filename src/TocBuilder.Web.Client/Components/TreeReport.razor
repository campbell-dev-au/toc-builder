@using TocBuilder.Domain

<ReportSection Title="UDEs with no path to a Core problem" Entities="Report.UdesWithoutCoreProblem" OnSelect="OnSelectEntity" />
<ReportSection Title="Core problems that explain no UDE" Entities="Report.CoreProblemsExplainingNoUde" OnSelect="OnSelectEntity" />
<ReportSection Title="Unconnected entities" Entities="Report.UnconnectedEntities" OnSelect="OnSelectEntity" />
<ReportSection Title="Root causes" Entities="Report.RootCauses" OnSelect="OnSelectEntity" />
<section>
    <h3>Open reservations (@Report.OpenReservations.Count)</h3>
    @if (Report.OpenReservations.Count > 0)
    {
        <ul>
            @foreach (var reservation in Report.OpenReservations)
            {
                <li>
                    <button type="button" class="link" @onclick="() => OnSelectTarget.InvokeAsync(reservation.Target)">@ReservationText.CategoryLabel(reservation.Category): @ReservationText.Describe(Tree, reservation.Target)</button>
                    @if (reservation.Note != "") { <span class="note"> – @reservation.Note</span> }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public Tree Tree { get; set; } = null!;
    [Parameter, EditorRequired] public TocBuilder.Domain.TreeReport Report { get; set; } = null!;
    [Parameter] public EventCallback<EntityId> OnSelectEntity { get; set; }
    [Parameter] public EventCallback<ReservationTarget> OnSelectTarget { get; set; }
}
