@using TocBuilder.Domain

<aside class="panel" aria-label="Details">
    @if (SelectedGhost is { } chosen)
    {
        <section class="selection" aria-label="Suggestion">
            <h2>Suggestion</h2>
            <textarea rows="4" value="@GhostEdit" @oninput="e => GhostEditChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" disabled="@(chosen.Existing is not null)" aria-label="Suggestion statement"></textarea>
            <div class="actions">
                <button type="button" @onclick="OnAcceptGhost">Accept suggestion</button>
                <button type="button" @onclick="OnDismissGhost">Dismiss suggestion</button>
            </div>
        </section>
    }
    else if (SelectedEntityCount >= 2)
    {
        <section class="selection" aria-label="Selection">
            <h2>@SelectedEntityCount entities selected</h2>
            <div class="actions">
                <button type="button" @onclick="OnMakeAnd" disabled="@(MakeAndUnavailable is not null)">Make AND (Ctrl+Enter)</button>
            </div>
            @if (MakeAndUnavailable is { } reason)
            {
                <p class="hint">@reason</p>
            }
        </section>
    }
    else if (SelectedEntity is { } current)
    {
        <section class="selection" aria-label="Entity">
            <h2>Entity @current.Code</h2>
            <label>Statement
                <textarea @key="(EditRevision, 0)" rows="5" value="@current.Statement" @onchange="OnEditSelected" aria-label="Selected entity statement"></textarea>
            </label>
            <label>Summary
                <input @key="(EditRevision, 2)" value="@current.Summary" @onchange="OnSummarySelected" maxlength="@Tree.MaxSummaryLength" placeholder="Summary (optional)" aria-label="Selected entity summary" />
            </label>
            <label>Code
                <input value="@current.Code" readonly aria-label="Selected entity code" />
            </label>
            <label>Tag
                <select @key="(EditRevision, 1)" value="@current.Tag" @onchange="OnTagSelected" aria-label="Selected entity tag">
                    <option value="@EntityTag.None">No tag</option>
                    <option value="@EntityTag.Ude">UDE</option>
                    <option value="@EntityTag.CoreProblem">Core problem</option>
                </select>
            </label>
            <div class="actions">
                <button type="button" @onclick="OnAddCause">Add cause (Tab)</button>
                <button type="button" @onclick="OnAddEffect">Add effect</button>
                <button type="button" @onclick="OnToggleLinking" aria-pressed="@(Linking ? "true" : "false")">Link: selected is a cause of…</button>
                <button type="button" @onclick="() => OnSuggest.InvokeAsync(SuggestionKind.Cause)" disabled="@Suggesting">Suggest causes</button>
                <button type="button" @onclick="() => OnSuggest.InvokeAsync(SuggestionKind.Effect)" disabled="@Suggesting">Suggest effects</button>
                <button type="button" @onclick="OnDelete">Delete (Del)</button>
            </div>
        </section>
    }
    else if (SelectedJunction is { } junctionId && Tree.Junctions.FirstOrDefault(j => j.Id == junctionId) is { } junction)
    {
        <section class="selection" aria-label="AND-junction">
            <h2>AND-junction</h2>
            <ul class="members">
                @foreach (var member in junction.Causes)
                {
                    <li>
                        <span>@EntityText.Label(Tree.Entities.First(e => e.Id == member))</span>
                        <button type="button" @onclick="() => OnRemoveFromJunction.InvokeAsync(member)" aria-label="Remove @Tree.Entities.First(e => e.Id == member).Code from AND-junction">Remove</button>
                    </li>
                }
            </ul>
            @{ var candidates = Tree.Entities.Where(e => Tree.CheckAddToJunction(junctionId, e.Id) == JunctionOutcome.Done).ToArray(); }
            @if (candidates.Length > 0)
            {
                <label>Add cause
                    <select @key="(EditRevision, junction.Causes.Count)" @onchange="e => addChoice = e.Value?.ToString() ?? string.Empty" aria-label="Entity to add to AND-junction">
                        <option value="">Choose an entity…</option>
                        @foreach (var candidate in candidates)
                        {
                            <option value="@candidate.Id.Value">@EntityText.Label(candidate)</option>
                        }
                    </select>
                </label>
                <div class="actions">
                    <button type="button" @onclick="AddChosen">Add to AND-junction</button>
                </div>
            }
            <div class="actions">
                <button type="button" @onclick="() => OnSuggest.InvokeAsync(SuggestionKind.CoCause)" disabled="@Suggesting">Suggest co-cause</button>
                <button type="button" @onclick="OnUngroup">Ungroup</button>
            </div>
        </section>
    }
    else if (Target is OnLink)
    {
        <section class="selection" aria-label="Causal link">
            <h2>Causal link</h2>
            <p>@ReservationText.Describe(Tree, Target)</p>
        </section>
    }
    else
    {
        <p class="hint">Select an entity, causal link or AND-junction to see its details.</p>
    }

    <ReservationPanel Tree="Tree" Target="Target" EditRevision="EditRevision" OnRaise="OnRaise" OnChangeState="OnChangeState" OnChangeNote="OnChangeNote" />

    <details class="report" open>
        <summary>Tree report</summary>
        <TreeReport Tree="Tree" Report="Report" OnSelectEntity="OnSelectEntity" OnSelectTarget="OnSelectTarget" />
    </details>
</aside>

@code {
    [Parameter, EditorRequired] public Tree Tree { get; set; } = null!;
    [Parameter, EditorRequired] public TocBuilder.Domain.TreeReport Report { get; set; } = null!;
    [Parameter] public ReservationTarget? Target { get; set; }
    [Parameter] public Entity? SelectedEntity { get; set; }
    [Parameter] public int SelectedEntityCount { get; set; }
    [Parameter] public string? MakeAndUnavailable { get; set; }   // why Make AND cannot be used on the selection; null when it can
    [Parameter] public JunctionId? SelectedJunction { get; set; }
    [Parameter] public bool Linking { get; set; }
    [Parameter] public bool Suggesting { get; set; }
    [Parameter] public Suggestion? SelectedGhost { get; set; }
    [Parameter] public string GhostEdit { get; set; } = "";
    [Parameter] public EventCallback<string> GhostEditChanged { get; set; }
    [Parameter] public int EditRevision { get; set; }

    [Parameter] public EventCallback OnAddCause { get; set; }
    [Parameter] public EventCallback OnAddEffect { get; set; }
    [Parameter] public EventCallback OnToggleLinking { get; set; }
    [Parameter] public EventCallback OnMakeAnd { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<EntityId> OnAddToJunction { get; set; }
    [Parameter] public EventCallback<EntityId> OnRemoveFromJunction { get; set; }
    [Parameter] public EventCallback OnUngroup { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnEditSelected { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnSummarySelected { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnTagSelected { get; set; }
    [Parameter] public EventCallback<SuggestionKind> OnSuggest { get; set; }
    [Parameter] public EventCallback OnAcceptGhost { get; set; }
    [Parameter] public EventCallback OnDismissGhost { get; set; }
    [Parameter] public EventCallback<(ReservationTarget Target, ClrCategory Category)> OnRaise { get; set; }
    [Parameter] public EventCallback<(ReservationId Id, ChangeEventArgs Args)> OnChangeState { get; set; }
    [Parameter] public EventCallback<(ReservationId Id, ChangeEventArgs Args)> OnChangeNote { get; set; }
    [Parameter] public EventCallback<EntityId> OnSelectEntity { get; set; }
    [Parameter] public EventCallback<ReservationTarget> OnSelectTarget { get; set; }

    private string addChoice = "";

    private async Task AddChosen()
    {
        if (!int.TryParse(addChoice, out var value)) return;
        addChoice = "";
        await OnAddToJunction.InvokeAsync(new EntityId(value));
    }
}
