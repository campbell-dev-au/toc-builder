<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TocBuilder.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="ClientOnly" />
</head>

<body>
    <Routes @rendermode="ClientOnly" />
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // The editor is client-only: skip server prerendering so state is not built twice.
    private static readonly InteractiveWebAssemblyRenderMode ClientOnly = new(prerender: false);
}
